# Sahaya AI / YojanaSetu Environment Configuration Example

APP_ENV=development
DATABASE_URL=sqlite:///./yojanasetu.db

# Phone Agent Number Configuration (Leave blank if unconfigured)
AI_AGENT_PHONE_NUMBER=

# SMS Provider Configuration ("mock" | "twilio")
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=

# Vector Database Abstraction ("local" | "pinecone")
VECTOR_STORE=local
PINECONE_API_KEY=
PINECONE_INDEX=yojanasetu-schemes
PINECONE_NAMESPACE=government-schemes

# Embedding Provider ("local" | "openai" | "gemini")
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_VERSION=v1
EMBEDDING_DIMENSION=384

# Reranker Provider ("local" | "none")
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM Provider ("nvidia" | "gemini" | "openai" | "mock")
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MAX_TOKENS=1024

# RAG Retrieval Parameters
RAG_DENSE_TOP_K=20
RAG_SPARSE_TOP_K=20
RAG_RERANK_TOP_K=8
RAG_FINAL_CONTEXT_TOP_K=5

CHUNK_MIN_TOKENS=100
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=1000

ENABLE_QUERY_EXPANSION=true
ENABLE_RERANKING=true
