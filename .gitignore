# =============================================================
# SAHAYA AI — Government Scheme Matching Platform
# .gitignore — Root-level rules covering frontend + backend
# =============================================================


# ───────────────────────────────────────────────────────────────
# ENVIRONMENT & SECRETS
# ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert


# ───────────────────────────────────────────────────────────────
# DATABASES & GENERATED DATA FILES
# ───────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
retrieval_metrics.json

# Generated / cache data — should not be committed
backend/data/cache/
backend/data/golden_dataset.json
backend/data/test_data/


# ───────────────────────────────────────────────────────────────
# FRONTEND — Node / Vite / React
# ───────────────────────────────────────────────────────────────
node_modules/
dist/
build/
.vite/
*.local

# Lockfiles — exclude auto-generated npm lockfile (use pnpm-lock.yaml)
package-lock.json
# yarn.lock


# ───────────────────────────────────────────────────────────────
# BACKEND — Python / FastAPI / UV
# ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.pyc

# Virtual environments
backend/.venv/
.venv/
venv/
env/
ENV/

# Egg / package build artifacts
*.egg-info/
*.egg
dist/
build/
.eggs/

# Distribution / packaging
.Python
pip-log.txt
pip-delete-this-directory.txt

# MyPy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# Pyright
pyrightconfig.json


# ───────────────────────────────────────────────────────────────
# TESTING & COVERAGE
# ───────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
*.log
nosetests.xml
test-results/


# ───────────────────────────────────────────────────────────────
# IDEs & EDITORS
# ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db
.project
.classpath
.settings/


# ───────────────────────────────────────────────────────────────
# OS GENERATED
# ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini


# ───────────────────────────────────────────────────────────────
# DOCKER
# ───────────────────────────────────────────────────────────────
# Uncomment if you don't want docker files tracked:
# Dockerfile
# docker-compose.yml
# docker-compose.override.yml


# ───────────────────────────────────────────────────────────────
# LOGS
# ───────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ───────────────────────────────────────────────────────────────
# MISC / TEMP
# ───────────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
.cache/
.figma/
